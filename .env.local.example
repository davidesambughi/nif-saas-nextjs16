# ============================================================
# GetNIFPortugal — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase ---
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase DB connection (Session Pooler recommended for Next.js — port 5432)
# Found in: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Stripe ---
# Found in: Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_PRICE_ID_STANDARD=price_xxx   # €49 one-time
STRIPE_PRICE_ID_EXPRESS=price_xxx    # €99 one-time

# --- Resend ---
# Found in: resend.com > API Keys
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@getnifportugal.com
RESEND_FROM_NAME=GetNIFPortugal

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GetNIFPortugal
